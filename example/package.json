    "expo-image-picker": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "^0.33.0",
    "react-native-nitro-wallpaper": "*"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react-native-monorepo-config": "^0.3.1",
    "typescript": "~6.0.3"
  }
}
